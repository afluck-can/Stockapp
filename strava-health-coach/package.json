{
  "name": "strava-health-coach",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server that exposes your Strava training data to Claude for body-recomposition coaching (fat loss + muscle gain goals).",
  "type": "module",
  "bin": {
    "strava-health-coach": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "auth": "tsx scripts/get-refresh-token.ts",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
